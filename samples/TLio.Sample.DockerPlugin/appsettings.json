{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Nuplane": {
    "Sources": {
      "Directory": {
        "Path": "/plugins",
        "Watch": true,
        "DebounceWindow": "00:00:02"
      }
    },
    "Loading": {
      "ActiveStoreRoot": "/tmp/nuplane-store"
    }
  }
}
