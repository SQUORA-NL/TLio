<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <!--
    Demo API for an ACTUS PAM (Principal at Maturity) contract, implemented entirely as TLio
    scripts under Scripts/ — the schedule walk and the event fold both run through
    TLio.Extensions.Looping (forEach/while), not native C#. See Scripts/README in this folder's
    own README.md for the ACTUS event/formula mapping.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\TLio.Json\TLio.Json.csproj" />
    <ProjectReference Include="..\..\TLio.Client\TLio.Client.csproj" />
    <ProjectReference Include="..\..\TLio.Extensions.Math\TLio.Extensions.Math.csproj" />
    <ProjectReference Include="..\..\TLio.Extensions.Text\TLio.Extensions.Text.csproj" />
    <ProjectReference Include="..\..\TLio.Extensions.TimeDate\TLio.Extensions.TimeDate.csproj" />
    <ProjectReference Include="..\..\TLio.Extensions.Looping\TLio.Extensions.Looping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Scripts/**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SampleInput/**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
