<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS8600;CS8602;CS8604;CS8618</WarningsNotAsErrors>

    <!-- Ship an XML documentation file with every library: without it the /// comments never
         leave this repository and consumers of the NuGet packages get no IntelliSense text at
         all, only bare signatures. The .xml is packed next to the .dll automatically.
         Test and sample projects are skipped — nothing consumes their documentation.
         (This has to live in .props: the SDK derives DocumentationFile from it before a
         Directory.Build.targets would be imported.)

         CS1591 (missing comment on a public member) is suppressed: undocumented members still
         get signature IntelliSense, and the alternative is 4000+ warnings. Malformed comments
         (CS1570/CS1573) are deliberately NOT suppressed — those break IntelliSense. -->
    <GenerateDocumentationFile Condition="!$(MSBuildProjectName.EndsWith('Tests')) And !$(MSBuildProjectName.StartsWith('TLio.Sample'))">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Strong naming.

    Every assembly in this repository is signed with the same key, and the key is committed
    next to it. That is deliberate and not a security hole: strong naming is an identity
    mechanism, not a tamper-proofing one — Microsoft says so outright — and .NET Core does not
    verify strong-name signatures at load time anyway.

    The reason TLio needs an identity at all is the plugin host. A NuPlane extension pack is
    loaded into its own AssemblyLoadContext, and the host has to declare which assemblies must
    come from *its* context instead so that `IFunctionsProviderRegistrar<JToken>` means one type
    on both sides. NuPlane expresses that as `SharedAssembly(name, publicKeyToken, major)` and
    validates that the token is 16 hex characters, i.e. it will not share an unsigned assembly.
    Without a strong name there is no way to say "this one is mine" — see
    samples/TLio.Sample.DockerPlugin/Program.cs.

    Signing everything, tests and samples included, keeps `InternalsVisibleTo` working: a signed
    assembly may only grant access to another signed assembly, and the attribute has to name the
    grantee's full public key.
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)tlio.snk</AssemblyOriginatorKeyFile>

    <!-- tlio.snk's public half, in the two forms that need it: the full key for
         InternalsVisibleTo (which will not take a token) and the token for NuPlane's
         SharedAssembly(). Both are derived from the key file, so they change only if it does.
         Read them back off any built assembly with AssemblyName.GetAssemblyName(). -->
    <TlioPublicKey></TlioPublicKey>
    <TlioPublicKeyToken>356c904b6d1035c0</TlioPublicKeyToken>
  </PropertyGroup>

  <!-- NuGet packaging defaults — library projects opt in with <IsPackable>true</IsPackable> -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Frans van Ek</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FransVanEk/TLio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FransVanEk/TLio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Versioning — the git tag is the only source of truth.

    MinVer reads the nearest `v*` tag and stamps Version, AssemblyVersion, FileVersion and the
    package version from it, at build time. There is deliberately no VersionPrefix here: a
    number written in this file drifts from the tags the moment someone forgets to bump it,
    which is exactly how `0.1.0-preview.N` packages kept being published after v0.8.0 was
    released. Because MinVer runs on every build, `dotnet pack` on a laptop produces the same
    version the pipeline does.

      on tag v1.2.3          ->  1.2.3
      3 commits past v1.2.3  ->  1.3.0-preview.3      (untagged main; auto-increment: minor)
      on tag v2.0.0-rc.1     ->  2.0.0-rc.1
      1 commit past that     ->  2.0.0-rc.1.1

    Steering a patch / minor / major release: docs/versioning.md.

    `preview` is a single identifier, so the commit height appends as `-preview.3` rather than
    MinVer's default `-alpha.0.3`. The price of that shorter form: never hand-push a
    `vX.Y.Z-preview.N` tag, or it interleaves with the automatic ones. Hand-tagged pre-releases
    use `-alpha`, `-beta` or `-rc`.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
    <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>

    <!-- No git repository to read (the Docker sample build copies sources only): MinVer would
         warn MINVER0001 and stamp 0.0.0-alpha.0, which reads like a real release. Skip it and
         say plainly what the build was. -->
    <MinVerSkip Condition="'$(MinVerSkip)' == '' And !Exists('$(MSBuildThisFileDirectory).git')">true</MinVerSkip>
    <Version Condition="'$(MinVerSkip)' == 'true'">0.0.0-nogit</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
