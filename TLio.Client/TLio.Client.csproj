<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>TLio Client: the scripting engine that parses and executes TLio scripts. Format-neutral — format support is registered through the provider pattern.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>tlio scripting engine client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TLio.Core\TLio.Core.csproj" />
    <ProjectReference Include="..\TLio.Commands\TLio.Commands.csproj" />
    <ProjectReference Include="..\TLio.Functions\TLio.Functions.csproj" />
  </ItemGroup>

  <!-- Declared here rather than in an AssemblyInfo.cs so the public key stays in one place
       (Directory.Build.props). Now that this assembly is signed, the grantee must be signed too
       and named with its full public key. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TLio.UnitTests, PublicKey=$(TlioPublicKey)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
