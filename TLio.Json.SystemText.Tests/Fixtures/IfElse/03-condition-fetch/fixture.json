{
  "input": { "flag": true },
  "script": [{
    "command": "ifElse",
    "condition": "=fetch($.flag)",
    "ifScript":   [{ "command": "put", "path": "$.result", "value": "yes" }],
    "elseScript": [{ "command": "put", "path": "$.result", "value": "no" }]
  }],
  "result": { "flag": true, "result": "yes" }
}
