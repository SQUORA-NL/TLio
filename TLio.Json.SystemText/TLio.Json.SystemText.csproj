<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>TLio System.Text.Json adapter: INodeAdapter and IItemsFetcher implementations backed by System.Text.Json.Nodes.JsonNode and the TLio.JsonPath engine. Provides identical transformation behaviour to TLio.Json (Newtonsoft) — the same JSONPath dialect, node for node — but using the in-box System.Text.Json stack. RFC 9535 is available as an opt-in dialect.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>tlio scripting json systemtext jsonpath rfc9535</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!--
      System.Text.Json is in-box from .NET 6 onward; no PackageReference needed.
      JSONPath comes from TLio.JsonPath, a standalone engine that runs on JsonNode directly and
      has no dependencies of its own (it replaces JsonCons.JsonPath).
    -->
    <ProjectReference Include="..\TLio.Core\TLio.Core.csproj" />
    <ProjectReference Include="..\TLio.JsonPath\TLio.JsonPath.csproj" />
  </ItemGroup>

  <!-- Declared here rather than in an AssemblyInfo.cs so the public key stays in one place
       (Directory.Build.props). Now that this assembly is signed, the grantee must be signed too
       and named with its full public key. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TLio.Json.SystemText.Tests, PublicKey=$(TlioPublicKey)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
