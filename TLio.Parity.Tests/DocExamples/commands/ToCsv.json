[
  {
    "title": "records to CSV",
    "input": {
      "records": [
        {
          "id": 1,
          "name": "Ada"
        },
        {
          "id": 2,
          "name": "Grace"
        }
      ]
    },
    "script": [
      {
        "command": "tocsv",
