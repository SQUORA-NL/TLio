[
  {
    "title": "three strings",
    "input": {
      "a": "Hello",
      "b": ", ",
      "c": "World"
    },
    "script": [
      {
        "command": "put",
        "path": "$.result",
        "value": "=concat($.a,$.b,$.c)"
      }
    ],
    "expected": {
      "a": "Hello",
      "b": ", ",
      "c": "World",
      "result": "Hello, World"
    }
  }
]