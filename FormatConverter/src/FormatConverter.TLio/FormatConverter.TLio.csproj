<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FormatConverter.TLio</RootNamespace>
    <AssemblyName>FormatConverter.TLio</AssemblyName>

    <!-- The package a consumer actually references: it pulls the three adapters and the core in
         behind it. Named without a suffix for that reason. -->
    <PackageId>TLio.FormatConverter</PackageId>
    <Description>The convert and convertValue commands for TLio, with MultiFormatScriptRunner — runs a script that changes the document's format partway through, re-hosting each section on the engine for its format. References the JSON, XML and YAML adapters.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>tlio scripting conversion json xml yaml</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FormatConverter.Core\FormatConverter.Core.csproj" />
    <ProjectReference Include="..\FormatConverter.Json\FormatConverter.Json.csproj" />
    <ProjectReference Include="..\FormatConverter.Xml\FormatConverter.Xml.csproj" />
    <ProjectReference Include="..\FormatConverter.Yaml\FormatConverter.Yaml.csproj" />
    <ProjectReference Include="..\..\..\TLio.Core\TLio.Core.csproj" />
    <ProjectReference Include="..\..\..\TLio.Client\TLio.Client.csproj" />
  </ItemGroup>
</Project>
