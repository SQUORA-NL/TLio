<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FormatConverter.Yaml</RootNamespace>
    <AssemblyName>FormatConverter.Yaml</AssemblyName>

    <PackageId>TLio.FormatConverter.Yaml</PackageId>
    <Description>YAML adapter for TLio format conversion (YamlDotNet), including anchor and alias flattening.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>tlio conversion yaml</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FormatConverter.Core\FormatConverter.Core.csproj" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
