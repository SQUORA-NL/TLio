<Project>

  <!--
    NuGet readme wiring.

    Every packable project ships its own README.md from its project directory.
    Remove-then-Include rather than `Update`: a project that targets several frameworks packs from the
    outer build, where the SDK's default item globs do not exist, so `Update` would match nothing and the
    readme would silently go missing (NU5039). Remove-then-Include is correct in both the outer and the
    inner builds and never adds a duplicate (NETSDK1022).

    PackageReadmeFile is only set when the file actually exists, otherwise pack
    fails with NU5039 on projects that have no readme.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true' AND Exists('$(MSBuildProjectDirectory)\README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true' AND Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    AssemblyVersion is deliberately left at MinVer's default of major-only: 0.9.0 and 0.10.0
    both produce AssemblyVersion 0.0.0.0, while Version, FileVersion and the package version
    stay exactly the tag.

    It is tempting to widen it to major.minor, since pre-1.0 the minor is the breaking bump.
    Don't. TLio.Sample.DockerPlugin (TLio-Samples) hot-loads extension packs as .nupkg files at runtime, and a
    pack compiled against `TLio.Core, Version=0.9.0.0` cannot bind to a host carrying 0.10.0.0 —
    moving AssemblyVersion on every minor means every plugin in the wild breaks on every
    release. Package versions still tell consumers exactly what they have.
  -->

</Project>
