<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>TLio JSON adapter: INodeAdapter and IItemsFetcher implementations backed by Newtonsoft.Json and JsonPath.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>tlio scripting json newtonsoft</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TLio.Core\TLio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One internal helper, compiled into each assembly that needs it rather than made public. -->
    <Compile Include="..\TLio.Core\Internal\PooledStringWriter.cs" Link="Internal\PooledStringWriter.cs" />
  </ItemGroup>

</Project>
