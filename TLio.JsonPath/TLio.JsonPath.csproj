<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Drop-in replacement for Newtonsoft's SelectToken/SelectTokens on System.Text.Json.Nodes.JsonNode: the same paths give the same nodes, in the same order, with the same errors — verified against Newtonsoft.Json itself. Full RFC 9535 (function extensions, I-Regexp) is there when you want the standard. No dependencies; does not reference Newtonsoft.Json.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>newtonsoft selecttoken selecttokens jsonpath system-text-json jsonnode json-path newtonsoft-migration rfc9535</PackageTags>
  </PropertyGroup>

  <!--
    This package is deliberately free of TLio. It is used by TLio.Json.SystemText, but it is a
    JSONPath engine first: `dotnet add package TLio.JsonPath` and a System.Text.Json document
    is all that is needed. Do not add a ProjectReference to any TLio.* project here.
    System.Text.Json is in-box; there is no PackageReference either.
  -->

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TLio.JsonPath.Tests, PublicKey=$(TlioPublicKey)</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TLio.JsonPath.Benchmarks, PublicKey=$(TlioPublicKey)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
